# Murshid settings. Copy to .env (gitignored) and fill in only what you need.
# Every line is optional, and an empty value means the default: see src/murshid/settings.py, and
# src/murshid/providers/factory.py for the default model ids and their prices. The settings are
# checked at start; a bad value stops the program with the variable's name, never its value.
# A variable set in the environment wins over this file.

# ---- Which provider answers (demo, UI, command line) ----
# extractive: quotes the retrieved passages; no key, no network (the default).
# replay:     recorded Claude / OpenAI answers to the bench questions, else extractive; no key.
# mock:       a fixed placeholder answer, for tests.
# claude | openai | gemini: paid; each needs its API key below.
LLM_PROVIDER=extractive

# ---- Paid providers: a key turns one on; an empty model id means the registry default ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=
OPENAI_API_KEY=
OPENAI_MODEL_ID=
GEMINI_API_KEY=
GEMINI_MODEL_ID=

# ---- Index build: the provider that writes each chunk's summary and keywords ----
# Same choices as LLM_PROVIDER; mock is free. For a paid one, pick a cheap model below
# (empty means that provider's default model).
METADATA_ENRICHMENT_PROVIDER=mock
METADATA_ENRICHMENT_MODEL_ID=

# ---- Bench judges: any claude-, gpt- or gemini- model id (empty means the default) ----
# The judge scores every answer; the default is out of family for Claude and OpenAI.
BENCH_JUDGE_MODEL=
# Re-scores 3 answers to measure judge bias, and judges instead when BENCH_JUDGE_MODEL has no key.
BENCH_SANITY_SWAP_JUDGE_MODEL=

# ---- Paths, relative to the working directory ----
# The corpus and the bench questions.
MURSHID_DATA_DIR=data
# Where the demo and the debugging scripts write their output.
MURSHID_OUT_DIR=out
# The recorded answers the replay provider reads, and the recorded model it replays, as
# <provider>/<model id> (empty means the bench's best: the OpenAI answers).
MURSHID_REPLAY_FILE=bench/case-cache.json
MURSHID_REPLAY_MODEL=
