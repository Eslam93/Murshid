# One image: the API, and the built web app it serves from the same origin.
# Base images come through REGISTRY, so a network that cannot reach Docker Hub can use a mirror.
ARG REGISTRY=mirror.gcr.io/library

# ---- 1 · the web app --------------------------------------------------------------------------
FROM ${REGISTRY}/node:22-slim AS web
WORKDIR /build
RUN npm install --global pnpm@10.33.0
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm exec vite build

# ---- 2 · the Python dependencies, with uv, from the lockfile ------------------------------------
FROM ${REGISTRY}/python:3.12.11-slim AS python
ENV UV_PYTHON_PREFERENCE=only-system UV_PYTHON_DOWNLOADS=never UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
RUN pip install --no-cache-dir uv==0.8.17
WORKDIR /srv
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# ---- 3 · what runs: no build tools, not root ----------------------------------------------------
FROM ${REGISTRY}/python:3.12.11-slim AS runtime
RUN useradd --system --uid 10001 --home-dir /srv app
WORKDIR /srv
COPY --from=python /srv/.venv /srv/.venv
COPY app app
COPY --from=web /build/app/web/dist app/web/dist
ENV PATH=/srv/.venv/bin:$PATH PYTHONPATH=/srv PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER app
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD ["python", "-c", "import sys, urllib.request as u; sys.exit(0 if u.urlopen('http://127.0.0.1:8000/api/health/live', timeout=3).status == 200 else 1)"]
CMD ["uvicorn", "app.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
